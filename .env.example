# ==============================================================================
# SARPAS BP3IP - Konfigurasi Environment Variables
# Salin file ini menjadi .env untuk pengembangan lokal:
# cp .env.example .env (Linux/Mac) atau Copy-Item .env.example .env (PowerShell)
# ==============================================================================

# Kunci rahasia Django (Ganti dengan string acak dan aman di server produksi)
DJANGO_SECRET_KEY=django-insecure-sarpas-bp3ip-dev-key-change-in-production

# Mode Debug (Gunakan True untuk development lokal, False untuk produksi)
DJANGO_DEBUG=True

# Host yang diizinkan (pisahkan dengan koma)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF Trusted Origins (opsional, jika mengakses dari domain/port tertentu)
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Pengaturan Database PostgreSQL (Opsional, jika tidak disetel maka default SQLite db.sqlite3)
# POSTGRES_DB=sarpas_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
